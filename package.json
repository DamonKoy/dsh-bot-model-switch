{
  "name": "dsh-bot-model-switch",
  "version": "0.4.0",
  "type": "module",
  "description": "Switch every Bot model at once, or set each Bot individually, through DS Bot own update-bot channel.",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.4"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    },
    "capabilities": [
      "network:egress"
    ],
    "labels": []
  },
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.1-rc.4",
    "node": ">=18"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-connection": "*"
  }
}
