{
  "name": "dsh-bot-model-switch",
  "version": "0.4.0",
  "type": "module",
  "description": "Switch every Bot model at once, or set each Bot individually, through DS Bot own update-bot channel.",
  "homepage": "https://github.com/DamonKoy/dsh-bot-model-switch#readme",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "ds-bot",
    "model-switch",
    "team"
  ],
  "repository": {
    "url": "git+https://github.com/DamonKoy/dsh-bot-model-switch.git",
    "type": "git"
  },
  "bugs": {
    "url": "https://github.com/DamonKoy/dsh-bot-model-switch/issues"
  },
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-0 <0.3.0-0 || >=0.2.2-alpha.2 <0.3.0-0"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    },
    "capabilities": [
      "network:egress"
    ],
    "manifestVersion": 1,
    "labels": []
  },
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.1-0 <0.3.0-0 || >=0.2.2-alpha.2 <0.3.0-0",
    "node": ">=18"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-connection": "*"
  }
}
